# ─── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=workshop_user
POSTGRES_PASSWORD=workshop_pass
POSTGRES_DB=workshop_db
POSTGRES_PORT=5432

# ─── pgAdmin ──────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@workshop.local
PGADMIN_PASSWORD=pgadmin123
PGADMIN_PORT=5050

# ─── Database URL (for Prisma — uses localhost for local dev) ─────
DATABASE_URL=postgresql://workshop_user:workshop_pass@localhost:5432/workshop_db

# ─── Session Secret (iron-session encryption key, min 32 chars) ──
SESSION_SECRET=change-me-to-a-random-32-char-string!!

# ─── Default Admin Seed Credentials ──────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=System Administrator

# ─── Web Push (VAPID Keys — generate with `npx web-push generate-vapid-keys`) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
