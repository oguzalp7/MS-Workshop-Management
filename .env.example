# ─── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# ─── pgAdmin ──────────────────────────────────────────────────────
PGADMIN_EMAIL=something@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ─── Database URL (for Prisma — uses localhost for local dev) ─────
DATABASE_URL=

# ─── Session Secret (iron-session encryption key, min 32 chars) ──
SESSION_SECRET=

# ─── Default Admin Seed Credentials ──────────────────────────────
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=

# ─── Web Push (VAPID Keys — generate with `npx web-push generate-vapid-keys`) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Cloudflare Tunnel (Zero Trust) ──────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Public Base URL (for local development use http://localhost:3000 or if you're using Cloudflare Tunnel use https://your-domain.com) ──────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=
